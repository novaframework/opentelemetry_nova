{erl_opts, [debug_info, warnings_as_errors]}.

{project_plugins, [erlfmt, rebar3_ex_doc]}.

{hex, [{doc, #{provider => ex_doc}}]}.

{ex_doc, [
    {proglang, erlang},
    {main, <<"readme">>},
    {extras, [<<"README.md">>, <<"LICENSE">>]},
    {source_url, <<"https://github.com/novaframework/opentelemetry_nova">>}
]}.

{deps, [
    {opentelemetry, "~> 1.5"},
    {opentelemetry_api, "~> 1.4"},
    {opentelemetry_api_experimental, "~> 0.5"},
    {opentelemetry_experimental, "~> 0.5"},
    {cowboy, "~> 2.13"},
    {nova, "~> 0.18"}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {plt_extra_apps, [
        cowboy,
        cowlib,
        nova,
        ranch,
        opentelemetry,
        opentelemetry_experimental,
        opentelemetry_api,
        opentelemetry_api_experimental
    ]},
    {plt_prefix, "rebar3"}
]}.

%% opentelemetry_experimental's otel_metrics.hrl names the type
%% eqwalizer:dynamic(), which Dialyzer reports as unknown. Patch it in this
%% repo's own _build. rebar3 runs a hook as `sh -c "exec Cmd"`, so a fallback
%% such as `|| true` needs its own shell; built as a dependency the path does
%% not exist and the hook must still succeed.
{pre_hooks, [
    {compile,
        "sh -c \"sed -i 's/eqwalizer:dynamic()/dynamic()/g' _build/default/lib/opentelemetry_experimental/include/otel_metrics.hrl 2>/dev/null || true\""}
]}.

{ct_compile_opts, [{i, "test/support"}]}.
{ct_first_files, [
    "test/support/fake_controller.erl",
    "test/support/otel_nova_test_controller.erl",
    "test/support/test_metric_exporter.erl",
    "test/support/capture_stream_h.erl",
    "test/support/otel_nova_test_router.erl",
    "test/support/otel_nova_test_handler.erl",
    "test/support/otel_nova_test_app.erl",
    "test/support/otel_nova_test_util.erl"
]}.

{profiles, [
    {test, [
        {extra_src_dirs, ["test/support"]}
    ]}
]}.
